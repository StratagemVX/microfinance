# Database (MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority

# Public base URL (used for password reset links)
APP_BASE_URL=http://your-domain-or-host:5000

# JWT
JWT_SECRET=replace-with-a-secure-random-string
JWT_EXPIRY=7d

# Server
PORT=5000
NODE_ENV=development

# Initial staff accounts only (required when the database has no admin accounts).
# Supply unique random values via deployment secrets; never commit a populated .env file.
SEED_SUPER_ADMIN_PASSWORD=replace-with-unique-random-secret-at-least-16-chars
SEED_LOAN_OFFICER_PASSWORD=replace-with-another-unique-random-secret
SEED_COMPLIANCE_OFFICER_PASSWORD=replace-with-another-unique-random-secret
SEED_CUSTOMER_SERVICE_PASSWORD=replace-with-another-unique-random-secret
